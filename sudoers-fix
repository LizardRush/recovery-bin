echo "[*] Detecting available volumes..."
echo

ls /Volumes
echo
echo "Enter the EXACT name of your Data volume (example: Macintosh HD - Data):"
read VOLNAME

VOL="/Volumes/$VOLNAME"

echo "[*] Using: $VOL"

if [ ! -d "$VOL/private/etc" ]; then
  echo "[*] Creating etc directory..."
  mkdir -p "$VOL/private/etc"
fi

echo "[*] Removing broken sudoers..."
rm -rf "$VOL/private/etc/sudoers"

echo "[*] Writing fresh sudoers file..."
cat <<'EOF' > "$VOL/private/etc/sudoers"
root ALL=(ALL) ALL
%admin ALL=(ALL) ALL
EOF

echo "[*] Fixing permissions..."
chown root:wheel "$VOL/private/etc/sudoers"
chmod 440 "$VOL/private/etc/sudoers"

echo
echo "[+] Done. Result:"
ls -l "$VOL/private/etc/sudoers"
echo
echo "[*] Reboot and test with: sudo whoami"
