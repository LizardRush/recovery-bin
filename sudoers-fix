ls /Volumes; echo "Type Data volume name:"; read V; D="/Volumes/$V"; mkdir -p "$D/private/etc"; rm -rf "$D/private/etc/sudoers"; printf "root ALL=(ALL) ALL\n%%admin ALL=(ALL) ALL\n" > "$D/private/etc/sudoers"; chown root:wheel "$D/private/etc/sudoers"; chmod 440 "$D/private/etc/sudoers"; ls -l "$D/private/etc/sudoers"; echo "Done. reboot and test sudo"
